# Used when running the backend natively (not via docker-compose), e.g.:
#   cd backend && cp .env.example .env && uvicorn app.main:app --reload
# See the root .env.example for the full set of options (Docker path).

APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://postgres:lenny_dev_password@127.0.0.1:5544/lenny_growth_assistant

LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

EMBEDDING_DIMENSIONS=768
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.55

SHIP30_TARGET_WORDS=1250
