# ============================================================================
# The Lenny Growth Assistant - environment configuration
# Copy to .env and adjust. Safe defaults are provided for the mandatory local
# (Ollama) demo - no cloud API key is required to run the app.
# ============================================================================

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Database (used by docker-compose; for native runs see README "Run without Docker") ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=lenny_dev_password
POSTGRES_DB=lenny_growth_assistant
# DATABASE_URL is set automatically by docker-compose.yml from the vars above.
# For a native (non-Docker) run, uncomment and point at your own Postgres:
# DATABASE_URL=postgresql+asyncpg://postgres:lenny_dev_password@127.0.0.1:5544/lenny_growth_assistant

# --- LLM provider selection ---
# One of: ollama | anthropic | openai
# Also switchable at runtime via the UI's model picker / POST /api/models/select
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama

# --- Ollama (mandatory local demo - no key required) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Anthropic (optional cloud provider) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- OpenAI (optional cloud provider) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Retrieval ---
EMBEDDING_DIMENSIONS=768
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.55

# --- Ship 30 essay ---
SHIP30_TARGET_WORDS=1250

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
